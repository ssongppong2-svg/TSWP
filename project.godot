; Engine configuration file.
config_version=5

[application]

config/name="TSWP"
config/description="The Strongest Warrior Party"
config/version="0.4.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

Prefs="*res://scripts/autoload/prefs.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/stretch/mode="disabled"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.36, 0.55, 0.47, 1)

[shader_globals]

bb_stretch={
"type": "float",
"value": 1.0
}
cam_fwd={
"type": "vec3",
"value": Vector3(0, -0.8, -0.6)
}
shade_map={
"type": "sampler2D",
"value": ""
}
shade_area={
"type": "vec4",
"value": Vector4(0, 0, 64, 64)
}
cut_plane={
"type": "vec4",
"value": Vector4(0, 0, 1, 10000)
}
lane_plane={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
focus_screen={
"type": "vec4",
"value": Vector4(-1000, -1000, 0, 0)
}
side_amt={
"type": "float",
"value": 0.0
}
atmo_col={
"type": "color",
"value": Color(0.61, 0.79, 0.71, 1)
}
wind_time={
"type": "float",
"value": 0.0
}
cam_pitch={
"type": "float",
"value": 0.9
}
push_a={
"type": "vec4",
"value": Vector4(0, -100, 0, 0)
}
push_b={
"type": "vec4",
"value": Vector4(0, -100, 0, 0)
}
push_c={
"type": "vec4",
"value": Vector4(0, -100, 0, 0)
}
push_d={
"type": "vec4",
"value": Vector4(0, -100, 0, 0)
}
